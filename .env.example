# Server Configuration
PORT=3000

# Optional: Default API provider (claude or gemini)
# Users can override this in the UI
DEFAULT_API_PROVIDER=claude

# Optional: Set API keys here for server-side usage
# Note: The app is designed to accept API keys from the frontend
# ANTHROPIC_API_KEY=your-claude-api-key-here
# GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: Enable debug logging
DEBUG=false

# Optional: Cache TTL in minutes
CACHE_TTL_MINUTES=15
